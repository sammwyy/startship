{
  "id": "jellyfin",
  "name": "Jellyfin",
  "icon": "film",
  "description": "A personal media server.",
  "version": "10.11",
  "containers": [
    {
      "id": "jellyfin",
      "image": "jellyfin/jellyfin:10.11",
      "mounts": {
        "config": "/config",
        "cache": "/cache",
        "media": "/media"
      },
      "healthcheck": "curl -fsS http://127.0.0.1:8096/health"
    }
  ],
  "volumes": [
    "config",
    "cache",
    "media"
  ],
  "http": [
    {
      "id": "web",
      "container": "jellyfin",
      "port": 8096
    }
  ],
  "config_schema": {
    "type": "object",
    "properties": {}
  }
}
