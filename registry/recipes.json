{
  "recipes": [
    {
      "id": "gitea",
      "name": "Gitea",
      "icon": "git-branch",
      "description": "Self-hosted Git repositories and collaboration.",
      "version": "1.24",
      "containers": [
        {
          "id": "gitea",
          "image": "gitea/gitea:1.24",
          "env": {
            "GITEA__server__ROOT_URL": "${root_url}",
            "GITEA__server__DISABLE_SSH": "true"
          },
          "mounts": {
            "data": "/data"
          },
          "healthcheck": "wget -q -O /dev/null http://127.0.0.1:3000/api/healthz"
        }
      ],
      "volumes": [
        "data"
      ],
      "http": [
        {
          "id": "web",
          "container": "gitea",
          "port": 3000
        }
      ],
      "config_schema": {
        "type": "object",
        "properties": {
          "root_url": {
            "type": "string",
            "title": "Public URL",
            "description": "Set to your mapped HTTPS domain before configuring Gitea.",
            "default": "http://localhost:3000/"
          }
        }
      }
    },
    {
      "id": "jellyfin",
      "name": "Jellyfin",
      "icon": "film",
      "description": "A personal media server.",
      "version": "10.11",
      "containers": [
        {
          "id": "jellyfin",
          "image": "jellyfin/jellyfin:10.11",
          "mounts": {
            "config": "/config",
            "cache": "/cache",
            "media": "/media"
          },
          "healthcheck": "curl -fsS http://127.0.0.1:8096/health"
        }
      ],
      "volumes": [
        "config",
        "cache",
        "media"
      ],
      "http": [
        {
          "id": "web",
          "container": "jellyfin",
          "port": 8096
        }
      ],
      "config_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "id": "minecraft",
      "name": "Minecraft",
      "icon": "box",
      "description": "A Minecraft Java Edition server.",
      "version": "1",
      "containers": [
        {
          "id": "minecraft",
          "image": "itzg/minecraft-server:java21",
          "env": {
            "EULA": "${eula}",
            "VERSION": "${version}",
            "MEMORY": "${memory}",
            "OVERRIDE_SERVER_PROPERTIES": "false"
          },
          "mounts": {
            "data": "/data"
          },
          "healthcheck": "mc-health"
        }
      ],
      "volumes": [
        "data"
      ],
      "ports": [
        {
          "id": "game",
          "container": "minecraft",
          "protocol": "tcp",
          "port": 25565,
          "host_port": 25565
        }
      ],
      "config_schema": {
        "type": "object",
        "required": [
          "eula",
          "version",
          "memory"
        ],
        "properties": {
          "eula": {
            "type": "string",
            "title": "Accept the Minecraft EULA",
            "description": "Read https://www.minecraft.net/eula before accepting.",
            "enum": [
              "TRUE"
            ]
          },
          "version": {
            "type": "string",
            "title": "Minecraft version",
            "default": "LATEST"
          },
          "memory": {
            "type": "string",
            "title": "Java memory",
            "default": "1G",
            "enum": [
              "512M",
              "1G",
              "2G",
              "4G"
            ]
          }
        }
      },
      "files": [
        {
          "id": "server-properties",
          "volume": "data",
          "path": "server.properties",
          "format": "properties",
          "schema": {
            "type": "object",
            "properties": {
              "motd": {
                "type": "string",
                "title": "Message of the day",
                "default": "A Startship Minecraft server"
              },
              "max-players": {
                "type": "integer",
                "title": "Maximum players",
                "minimum": 1,
                "maximum": 100,
                "default": 20
              },
              "difficulty": {
                "type": "string",
                "title": "Difficulty",
                "enum": [
                  "peaceful",
                  "easy",
                  "normal",
                  "hard"
                ],
                "default": "normal"
              },
              "online-mode": {
                "type": "boolean",
                "title": "Require authenticated players",
                "default": true
              }
            }
          }
        }
      ]
    },
    {
      "id": "teamspeak",
      "name": "TeamSpeak",
      "icon": "headphones",
      "description": "TeamSpeak 3 voice chat server.",
      "version": "3.13",
      "containers": [
        {
          "id": "teamspeak",
          "image": "teamspeak:3.13",
          "env": {
            "TS3SERVER_LICENSE": "${license}"
          },
          "mounts": {
            "data": "/var/ts3server"
          }
        }
      ],
      "volumes": [
        "data"
      ],
      "ports": [
        {
          "id": "voice",
          "container": "teamspeak",
          "protocol": "udp",
          "port": 9987,
          "host_port": 9987
        },
        {
          "id": "files",
          "container": "teamspeak",
          "protocol": "tcp",
          "port": 30033,
          "host_port": 30033
        }
      ],
      "config_schema": {
        "type": "object",
        "required": [
          "license"
        ],
        "properties": {
          "license": {
            "type": "string",
            "title": "Accept the TeamSpeak license",
            "description": "Use the applicable TeamSpeak server license terms.",
            "enum": [
              "accept"
            ]
          }
        }
      }
    }
  ]
}
