{
  "id": "gitea",
  "name": "Gitea",
  "icon": "git-branch",
  "description": "Self-hosted Git repositories and collaboration.",
  "version": "1.24",
  "containers": [
    {
      "id": "gitea",
      "image": "gitea/gitea:1.24",
      "env": {
        "GITEA__server__ROOT_URL": "${root_url}",
        "GITEA__server__DISABLE_SSH": "true"
      },
      "mounts": {
        "data": "/data"
      },
      "healthcheck": "wget -q -O /dev/null http://127.0.0.1:3000/api/healthz"
    }
  ],
  "volumes": [
    "data"
  ],
  "http": [
    {
      "id": "web",
      "container": "gitea",
      "port": 3000
    }
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "root_url": {
        "type": "string",
        "title": "Public URL",
        "description": "Set to your mapped HTTPS domain before configuring Gitea.",
        "default": "http://localhost:3000/"
      }
    }
  }
}
