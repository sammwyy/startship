{
  "name": "@startship/dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write src *.json *.ts index.html",
    "format:check": "prettier --check src *.json *.ts index.html"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.10",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.11",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.12"
  }
}
