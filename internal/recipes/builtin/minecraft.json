{
  "id": "minecraft",
  "name": "Minecraft",
  "icon": "box",
  "description": "A Minecraft Java Edition server.",
  "version": "1",
  "containers": [
    {
      "id": "minecraft",
      "image": "itzg/minecraft-server:java21",
      "env": {
        "EULA": "${eula}",
        "VERSION": "${version}",
        "MEMORY": "${memory}",
        "OVERRIDE_SERVER_PROPERTIES": "false"
      },
      "mounts": {
        "data": "/data"
      },
      "healthcheck": "mc-health"
    }
  ],
  "volumes": [
    "data"
  ],
  "ports": [
    {
      "id": "game",
      "container": "minecraft",
      "protocol": "tcp",
      "port": 25565,
      "host_port": 25565
    }
  ],
  "config_schema": {
    "type": "object",
    "required": [
      "eula",
      "version",
      "memory"
    ],
    "properties": {
      "eula": {
        "type": "string",
        "title": "Accept the Minecraft EULA",
        "description": "Read https://www.minecraft.net/eula before accepting.",
        "enum": [
          "TRUE"
        ]
      },
      "version": {
        "type": "string",
        "title": "Minecraft version",
        "default": "LATEST"
      },
      "memory": {
        "type": "string",
        "title": "Java memory",
        "default": "1G",
        "enum": [
          "512M",
          "1G",
          "2G",
          "4G"
        ]
      }
    }
  },
  "files": [
    {
      "id": "server-properties",
      "volume": "data",
      "path": "server.properties",
      "format": "properties",
      "schema": {
        "type": "object",
        "properties": {
          "motd": {
            "type": "string",
            "title": "Message of the day",
            "default": "A Startship Minecraft server"
          },
          "max-players": {
            "type": "integer",
            "title": "Maximum players",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "difficulty": {
            "type": "string",
            "title": "Difficulty",
            "enum": [
              "peaceful",
              "easy",
              "normal",
              "hard"
            ],
            "default": "normal"
          },
          "online-mode": {
            "type": "boolean",
            "title": "Require authenticated players",
            "default": true
          }
        }
      }
    }
  ]
}
